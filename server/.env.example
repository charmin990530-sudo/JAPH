# Copia este archivo como .env y completa los valores.
# .env nunca se sube al repositorio (ver .gitignore).

# Entorno de ejecución: development | production
NODE_ENV=development

# Puerto en el que escucha el servidor
PORT=4000

# Cadena de conexión de MongoDB.
# Local:  mongodb://127.0.0.1:27017/japh
# Atlas:  mongodb+srv://cluster.mongodb.net/japh
MONGODB_URI=mongodb://127.0.0.1:27017/japh

# Origen (u orígenes, separados por comas) autorizados a llamar a la API.
# Debe coincidir exactamente con el dominio del cliente, sin barra final.
CLIENT_URL=http://localhost:5173

# Límite de solicitudes al formulario de contacto por IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5
